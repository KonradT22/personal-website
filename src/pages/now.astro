---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
---

<Base title="Now — Konrad Trestka">
  <div class="wrap">
    <Nav />

    <article class="page">
      <header class="page-header">
        <p class="eyebrow">What I'm doing now</p>
        <h1>Now</h1>
        <p class="updated">Updated June 2026 · Minneapolis</p>
      </header>

      <div class="body">
        <ul>
          <li>
            Running the neural surrogate pricer research (the UROP) full-time
            this summer — building and evaluating the model, running experiments
            on the university HPC.
          </li>
          <li>
            Iterating on AJAP, my personal job-search aggregator. Making the
            classification smarter.
          </li>
          <li>
            Open to 2027 full-time roles and off-cycle internships — quant dev,
            trading systems, or research engineering. Reach out if the work is
            interesting.
          </li>
        </ul>
      </div>

      <div class="note">
        <p>
          This is a <a href="https://nownownow.com/about">/now page</a>. It
          reflects what I'm focused on at the moment, not a comprehensive bio.
          The <a href="/about">about page</a> has the rest.
        </p>
      </div>
    </article>
  </div>
</Base>

<style>
  .page {
    max-width: 60ch;
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(3rem, 7vw, 5rem);
  }
  .page-header {
    margin-bottom: clamp(2rem, 5vw, 3rem);
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--line);
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.9rem;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
  }
  .updated {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--muted);
    margin: 0;
  }

  .body ul {
    margin: 0 0 2.5rem;
    padding: 0 0 0 1.1rem;
    display: grid;
    gap: 1rem;
  }
  .body li {
    font-size: 1rem;
    color: var(--muted);
    line-height: 1.75;
  }

  .note {
    border-top: 1px solid var(--line);
    padding-top: 1.75rem;
  }
  .note p {
    font-size: 0.88rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.7;
  }
  .note a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: var(--line);
    transition: color 0.15s, text-decoration-color 0.15s;
  }
  .note a:hover { color: var(--accent); text-decoration-color: var(--accent); }
</style>
