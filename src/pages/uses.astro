---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
---

<Base title="Uses — Konrad Trestka">
  <div class="wrap">
    <Nav />

    <article class="page">
      <header class="page-header">
        <p class="eyebrow">What I use</p>
        <h1>Uses</h1>
        <p class="updated">Last updated June 2026</p>
      </header>

      <div class="uses-body">
        <div class="uses-section">
          <p class="uses-label">hardware</p>
          <ul>
            <li>
              <span class="item-name">MacBook Pro</span>
              <span class="item-note">daily driver</span>
            </li>
            <li>
              <span class="item-name">ThinkPad running Kali Linux</span>
              <span class="item-note">always-on home server — self-hosting, monitoring</span>
            </li>
          </ul>
        </div>

        <div class="uses-section">
          <p class="uses-label">software</p>
          <ul>
            <li>
              <span class="item-name">VS Code</span>
              <span class="item-note">primary editor, with a Claude coding agent</span>
            </li>
            <li>
              <span class="item-name">Cursor / Claude Code</span>
              <span class="item-note">AI-assisted development</span>
            </li>
          </ul>
        </div>

        <div class="uses-section">
          <p class="uses-label">compute</p>
          <ul>
            <li>
              <span class="item-name">University of Minnesota HPC</span>
              <span class="item-note">SLURM jobs for ML training and simulation</span>
            </li>
            <li>
              <span class="item-name">DigitalOcean</span>
              <span class="item-note">live trading engine deployment</span>
            </li>
          </ul>
        </div>
      </div>

      <p class="note">More detail to come.</p>
    </article>
  </div>
</Base>

<style>
  .page {
    max-width: 60ch;
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(3rem, 7vw, 5rem);
  }
  .page-header {
    margin-bottom: clamp(2rem, 5vw, 3rem);
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--line);
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.9rem;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
  }
  .updated {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--muted);
    margin: 0;
  }

  .uses-body { display: grid; gap: 2.5rem; }

  .uses-section > ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .uses-section > ul > li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
    flex-wrap: wrap;
  }
  .uses-section > ul > li:first-child { border-top: 1px solid var(--line); }

  .uses-label {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.75rem;
  }
  .item-name {
    font-size: 0.95rem;
    color: var(--text);
  }
  .item-note {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--muted);
  }

  .note {
    margin-top: 3rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
    opacity: 0.6;
  }
</style>
