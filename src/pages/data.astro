---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import VolSurface from '../components/VolSurface.astro';
import { basics, laneConfigs, skills } from '../data/profile';

const lane = laneConfigs.data;
const emphasizedSkills = lane.emphasizedSkillKeys.map(k => ({
  label: k === 'dataEng' ? 'data engineering'
       : k === 'systems' ? 'systems / infra'
       : k === 'quant'   ? 'quant / research'
       : k,
  items: skills[k],
}));
---

<Base
  title="Data Engineering — Konrad Trestka"
  description={lane.sub}
>
  <div class="wrap">
    <Nav currentLane="data" />

    <!-- ── Hero ─────────────────────────────────────────── -->
    <section class="hero">
      <div class="hero-text">
        <p class="eyebrow">{lane.eyebrow}</p>
        <h1>Konrad<br />Trestka</h1>
        <p class="sub">{lane.sub}</p>

        <ul class="proof">
          {lane.proofPoints.map(p => (
            <li>
              <span class="tick">{p.n}</span>
              <p>{p.segments.map(s => s.bold ? <span class="big">{s.text}</span> : s.text)}</p>
            </li>
          ))}
        </ul>

        <div class="links">
          <a href={basics.github}>github</a>
          <a href={basics.linkedin}>linkedin</a>
          <a href={`mailto:${basics.email}`}>email</a>
          <a href={lane.resume} class="resume-link" target="_blank" rel="noopener">résumé ↓</a>
        </div>
      </div>

      <VolSurface />
    </section>

    <!-- ── Featured Work ─────────────────────────────────── -->
    <section class="section">
      <p class="section-label">selected work — data engineering</p>
      <div class="work-grid">
        {lane.featuredItems.map(item => (
          <article class="fig-card">
            <div class="fig-meta">
              <span class="fig-num">{item.fig}</span>
              {item.context && <span class="fig-ctx">{item.context}</span>}
            </div>
            <h3 class="fig-title">{item.title}</h3>
            <p class="fig-stack">{item.stack}</p>
            <p class="fig-desc">{item.description}</p>
            <div class="fig-footer">
              <span class="lanes">{item.displayLanes.join(' · ')}</span>
              {item.github && <a href={item.github} class="fig-link">github →</a>}
            </div>
          </article>
        ))}
      </div>
      <a href="/work" class="all-link">all work →</a>
    </section>

    <!-- ── Emphasized Skills ──────────────────────────────── -->
    <section class="section">
      <p class="section-label">skills — this lane</p>
      <div class="skills-grid">
        {emphasizedSkills.map(group => (
          <div class="skill-group">
            <p class="skill-label">{group.label}</p>
            <ul class="skill-list">
              {group.items.map(s => <li>{s}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Contact ───────────────────────────────────────── -->
    <section class="section">
      <p class="section-label">contact</p>
      <p class="contact-text">
        I'm at the University of Minnesota through May 2027 — open to 2027
        roles and off-cycle internships. English and Polish.
      </p>
      <div class="contact-links">
        <a href={`mailto:${basics.email}`}>{basics.email}</a>
        <a href={basics.github}>github</a>
        <a href={basics.linkedin}>linkedin</a>
      </div>
    </section>

  </div>
</Base>

<style>
  /* ── hero ─────────────────────────────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding: clamp(2.5rem, 7vw, 5rem) 0;
  }
  @media (max-width: 820px) { .hero { grid-template-columns: 1fr; } }

  .eyebrow {
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 1.2rem;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(3.2rem, 8vw, 5.2rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0 0 1.1rem;
  }
  .sub {
    font-size: 1.12rem;
    color: var(--muted);
    max-width: 34ch;
    margin: 0 0 2rem;
    line-height: 1.65;
  }

  .proof {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    gap: 0.95rem;
  }
  .proof li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    align-items: start;
  }
  .tick {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--accent);
    padding-top: 0.35rem;
  }
  .proof p { margin: 0; font-size: 0.98rem; color: var(--muted); line-height: 1.65; }
  .big { font-family: var(--serif); font-weight: 600; color: var(--text); }

  .links {
    display: flex;
    gap: 1.3rem;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 0.8rem;
  }
  .links a {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: color 0.15s, border-color 0.15s;
  }
  .links a:hover { color: var(--accent); border-color: var(--accent); }
  .resume-link { color: var(--muted); }

  /* ── shared section chrome ────────────────────────────── */
  .section {
    border-top: 1px solid var(--line);
    padding: clamp(3rem, 7vw, 5rem) 0;
  }
  .section-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 2.5rem;
  }
  .all-link {
    display: inline-block;
    margin-top: 2rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: color 0.15s, border-color 0.15s;
  }
  .all-link:hover { color: var(--accent); border-color: var(--accent); }

  /* ── work grid ────────────────────────────────────────── */
  .work-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  @media (max-width: 680px) { .work-grid { grid-template-columns: 1fr; } }

  /* first card (PURIS) is full width */
  .fig-card:first-child { grid-column: 1 / -1; }

  .fig-card {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
  }
  .fig-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }
  .fig-num {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--muted);
  }
  .fig-ctx {
    font-family: var(--mono);
    font-size: 0.62rem;
    color: var(--muted);
    opacity: 0.6;
  }
  .fig-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.25rem;
    margin: 0 0 0.35rem;
    line-height: 1.25;
  }
  .fig-stack {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--muted);
    margin: 0 0 1rem;
  }
  .fig-desc {
    font-size: 0.93rem;
    color: var(--muted);
    line-height: 1.65;
    margin: 0 0 1.5rem;
    flex: 1;
  }
  .fig-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .lanes {
    font-family: var(--mono);
    font-size: 0.65rem;
    color: var(--muted);
  }
  .fig-link {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s;
  }
  .fig-link:hover { color: var(--accent); }

  /* ── skills ───────────────────────────────────────────── */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  @media (max-width: 480px) { .skills-grid { grid-template-columns: 1fr; } }

  .skill-label {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1rem;
  }
  .skill-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .skill-list li {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.4;
  }

  /* ── contact ──────────────────────────────────────────── */
  .contact-text {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 48ch;
    margin: 0 0 1.5rem;
    line-height: 1.7;
  }
  .contact-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 0.8rem;
  }
  .contact-links a {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: color 0.15s, border-color 0.15s;
  }
  .contact-links a:hover { color: var(--accent); border-color: var(--accent); }
</style>
