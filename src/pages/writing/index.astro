---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Writing — Konrad Trestka">
  <div class="wrap">
    <Nav current="writing" />

    <div class="page-header">
      <p class="eyebrow">Writing</p>
      <h1>Notes</h1>
      <p class="intro">
        Technical notes, research observations, and the occasional longer piece.
      </p>
    </div>

    {posts.length > 0 ? (
      <ul class="post-list">
        {posts.map(p => (
          <li>
            <a href={`/writing/${p.id}`} class="post-row">
              <div class="post-left">
                <span class="post-title">{p.data.title}</span>
                {p.data.description && (
                  <span class="post-desc">{p.data.description}</span>
                )}
              </div>
              <span class="post-date">
                {p.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty">
        <p>Nothing published yet.</p>
      </div>
    )}
  </div>
</Base>

<style>
  .page-header {
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--line);
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.9rem;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }
  .intro {
    font-size: 1rem;
    color: var(--muted);
    max-width: 48ch;
    margin: 0;
    line-height: 1.65;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }
  .post-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 2rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
    transition: color 0.15s;
  }
  .post-list li:first-child .post-row { border-top: 1px solid var(--line); }
  .post-row:hover .post-title { color: var(--accent); }

  .post-left { display: flex; flex-direction: column; gap: 0.2rem; }
  .post-title { font-size: 1rem; transition: color 0.15s; }
  .post-desc { font-size: 0.88rem; color: var(--muted); }
  .post-date {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .empty {
    padding: 4rem 0;
    border-top: 1px solid var(--line);
  }
  .empty p {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0;
  }
</style>
