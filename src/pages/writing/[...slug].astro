---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing', p => !p.data.draft);
  return posts.map(p => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateStr = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={`${post.data.title} — Konrad Trestka`} description={post.data.description}>
  <div class="wrap">
    <Nav current="writing" />

    <article class="post">
      <header class="post-header">
        <p class="post-date">{dateStr}</p>
        <h1>{post.data.title}</h1>
        {post.data.description && <p class="post-desc">{post.data.description}</p>}
      </header>

      <div class="post-body">
        <Content />
      </div>

      <footer class="post-footer">
        <a href="/writing">← all writing</a>
      </footer>
    </article>
  </div>
</Base>

<style>
  .post {
    max-width: 68ch;
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(3rem, 7vw, 5rem);
  }
  .post-header {
    margin-bottom: clamp(2rem, 5vw, 3rem);
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--line);
  }
  .post-date {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
    margin: 0 0 0.9rem;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(1.8rem, 4.5vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0 0 0.75rem;
  }
  .post-desc {
    font-size: 1rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.65;
  }

  /* prose */
  .post-body :global(p) {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--muted);
    margin: 0 0 1.3rem;
  }
  .post-body :global(p:last-child) { margin-bottom: 0; }
  .post-body :global(h2) {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.4rem;
    margin: 2.5rem 0 0.75rem;
    color: var(--text);
  }
  .post-body :global(h3) {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.1rem;
    margin: 2rem 0 0.6rem;
    color: var(--text);
  }
  .post-body :global(code) {
    font-family: var(--mono);
    font-size: 0.85em;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 0.1em 0.35em;
    color: var(--text);
  }
  .post-body :global(pre) {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  .post-body :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.85rem;
    line-height: 1.65;
  }
  .post-body :global(blockquote) {
    border-left: 2px solid var(--accent);
    margin: 1.5rem 0;
    padding: 0 0 0 1.25rem;
    color: var(--muted);
  }
  .post-body :global(ul), .post-body :global(ol) {
    padding-left: 1.25rem;
    margin: 0 0 1.3rem;
    color: var(--muted);
  }
  .post-body :global(li) {
    font-size: 1rem;
    line-height: 1.75;
    margin-bottom: 0.35rem;
  }
  .post-body :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: var(--line);
    transition: text-decoration-color 0.15s;
  }
  .post-body :global(a:hover) { text-decoration-color: var(--accent); }

  .post-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .post-footer a {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .post-footer a:hover { color: var(--accent); }
</style>
