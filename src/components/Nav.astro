---
interface Props {
  current?: 'work' | 'research' | 'writing' | 'about';
  currentLane?: 'quant' | 'data' | 'systems';
}
const { current, currentLane } = Astro.props;
---

<header class="site-header">
  <div class="top">
    <a href="/" class="mark">konrad trestka<b>.</b></a>
    <nav class="topnav">
      <a href="/work"     class:list={[{ active: current === 'work'     }]}>work</a>
      <a href="/research" class:list={[{ active: current === 'research' }]}>research</a>
      <a href="/writing"  class:list={[{ active: current === 'writing'  }]}>writing</a>
      <a href="/about"    class:list={[{ active: current === 'about'    }]}>about</a>
    </nav>
  </div>
  <div class="lane-bar">
    <nav class="lane-nav">
      <a href="/"        class:list={[{ active: currentLane === 'quant'    }]}>quant</a>
      <a href="/data"    class:list={[{ active: currentLane === 'data'     }]}>data</a>
      <a href="/systems" class:list={[{ active: currentLane === 'systems'  }]}>systems</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }

  /* ── main nav row ─────────────────────────────────────── */
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 56px;
  }
  .mark {
    font-family: var(--mono);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--text);
    text-decoration: none;
  }
  .mark b { color: var(--accent); font-weight: 500; }

  .topnav {
    display: flex;
    gap: 1.4rem;
    font-family: var(--mono);
    font-size: 0.78rem;
  }
  .topnav a {
    color: var(--muted);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .topnav a:hover { color: var(--text); }
  .topnav a.active { color: var(--text); border-color: var(--accent); }

  /* ── lane switcher ────────────────────────────────────── */
  .lane-bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    height: 28px;
    border-top: 1px solid var(--line);
  }
  .lane-nav {
    display: flex;
    gap: 1.1rem;
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
  }
  .lane-nav a {
    color: var(--muted);
    text-decoration: none;
    opacity: 0.55;
    padding-bottom: 1px;
    border-bottom: 1px solid transparent;
    transition: opacity 0.15s, color 0.15s, border-color 0.15s;
  }
  .lane-nav a:hover { opacity: 1; }
  .lane-nav a.active {
    color: var(--accent);
    opacity: 1;
    border-color: var(--accent);
  }

  @media (max-width: 480px) {
    .topnav { gap: 1rem; font-size: 0.72rem; }
    .lane-nav { gap: 0.85rem; }
  }
</style>
